# =====================================================================
# .env — lido pelo frontend (vai para o bundle do navegador)
# =====================================================================
# Valores em Supabase Dashboard > Project Settings > API
#
# TUDO que começa com VITE_ é inlinado como TEXTO PURO no JavaScript que o
# navegador baixa. Qualquer pessoa lê no F12. Portanto:
#   - a anon / publishable key pode: ela é pública por natureza, a RLS protege
#   - a service_role / secret key NUNCA: ela ignora a RLS por completo
# O vite.config.ts derruba o build se detectar uma chave secreta aqui.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Usuário do apresentador — um nome, não um e-mail. Internamente vira
# `apresentador@pulso.local`, porque o Supabase Auth exige e-mail ou telefone
# como identificador; esse endereço é sintético e nunca recebe mensagem.
# A tela de login pede só a senha. Padrão: apresentador
VITE_PRESENTER_USER=apresentador


# =====================================================================
# .env.local — usado por setup e exportação PNG, nunca vai para o bundle
# =====================================================================
# Copie o bloco abaixo para um arquivo .env.local (já está no .gitignore).
# Sem prefixo VITE_, então o Vite ignora e nada disso chega ao navegador.
#
# SUPABASE_ACCESS_TOKEN=sbp_...      # supabase.com/dashboard/account/tokens
# SUPABASE_PROJECT_REF=xxxxxxxxxxxx  # o subdomínio da URL do projeto
# PRESENTER_PASSWORD=                 # defina localmente, com 8 ou mais caracteres
# PRESENTER_USER=apresentador        # opcional, este é o padrão
